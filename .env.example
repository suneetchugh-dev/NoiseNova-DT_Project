# Noise Nova hub configuration

# Port the hub listens on. 0.0.0.0 so phones on the same Wi-Fi can reach it.
PORT=8787

# Set to a random string to require a shared token on ingest + socket pairing.
# Leave empty for an open hub on a trusted local network.
# Generate one with: node -e "console.log(crypto.randomUUID())"
HUB_TOKEN=

# Where the SQLite file lives.
DB_PATH=./data/noise-nova.db

# Optional: baked-in hub URL for the Android build. Leave empty to use the
# in-app pairing screen. Example: http://192.168.1.42:8787
VITE_HUB_URL=
